# ResearchPilot Backend - environment configuration
#
# Usage:
#   cp Backend/.env.example Backend/.env    then fill in the values you need.
#
# Backend/.env is git-ignored (root .gitignore) and is loaded automatically
# on startup via python-dotenv. Real environment variables always take
# precedence over .env values. This example file contains PLACEHOLDERS ONLY -
# never put real API keys, passwords, or tokens in this file or anywhere in Git.

# ── Database ─────────────────────────────────────────────────────────────────
# Default is a local SQLite database (no extra setup required).
# For the PostgreSQL/pgvector deployment described in the README architecture
# section, use a connection string such as:
#   postgresql://user:password@localhost:5432/researchpilot
# NOTE: connection URLs can contain credentials. Keep them only in Backend/.env.
DATABASE_URL=sqlite:///data/researchpilot.db

# ── Application ──────────────────────────────────────────────────────────────
# Development mode (verbose startup report). Set to false for production.
DEBUG=true

# ── LLM / Verification service (reserved) ────────────────────────────────────
# The evidence verifier currently runs on a built-in heuristic engine and
# makes NO external LLM calls, so no key is required today. This variable is
# reserved for wiring a provider such as Google Gemini into the verifier:
#   Gemini API keys are created in Google AI Studio (aistudio.google.com/apikey)
#   and have the form "AIza..." - paste the key ONLY into Backend/.env.
# Example placeholder (do NOT commit a real key):
LLM_API_KEY=
# Model identifier recorded in traces, manifests, and the startup report.
LLM_MODEL=researchpilot-verifier-v1

# ── Authentication (JWT) ─────────────────────────────────────────────────────
# REQUIRED for any real deployment. If left empty, the backend generates a
# random ephemeral key per process: dev usage keeps working, but all login
# sessions are invalidated on every restart.
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Signing algorithm used for authentication tokens.
JWT_ALGORITHM=HS256

# ── External scholarly APIs (no configuration needed) ────────────────────────
# Literature retrieval uses public, key-less APIs:
#   - Semantic Scholar Graph API  (api.semanticscholar.org)
#   - OpenAlex                    (api.openalex.org)
#   - CrossRef                    (api.crossref.org)
# If you later add a paid tier (e.g. Semantic Scholar API key via the
# x-api-key header), add a variable here such as S2_API_KEY= and read it in
# app/services/paper_fetcher.py - never hard-code it in source.
